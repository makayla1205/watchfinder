<%- include('../../partials/header') %>
<%- include('../../partials/profileheader') %>    
    <div class="profile-main">
        <div class="flex-row">
           <h2>Your Lists</h2> 
           <a href="lists/new" class="btn">Create New List</a>
        </div>
        <div class="">
            <% for(var i=0; i < list?.length; i++) {  %>
                <div class="h-card">
                <div class="h-card-description">
                    <h3><a href="lists/<%= list[i].id %>"><%= list[i].name%></a></h3>
                    <p><%= list[i].description%></p>
                    <div class="card-action btn-group">
                        <a href="lists/<%= list[i].id %>/edit" class="btn"><svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path fill="#FFFFFF" d="M535.6 85.7C513.7 63.8 478.3 63.8 456.4 85.7L432 110.1L529.9 208L554.3 183.6C576.2 161.7 576.2 126.3 554.3 104.4L535.6 85.7zM236.4 305.7C230.3 311.8 225.6 319.3 222.9 327.6L193.3 416.4C190.4 425 192.7 434.5 199.1 441C205.5 447.5 215 449.7 223.7 446.8L312.5 417.2C320.7 414.5 328.2 409.8 334.4 403.7L496 241.9L398.1 144L236.4 305.7zM160 128C107 128 64 171 64 224L64 480C64 533 107 576 160 576L416 576C469 576 512 533 512 480L512 384C512 366.3 497.7 352 480 352C462.3 352 448 366.3 448 384L448 480C448 497.7 433.7 512 416 512L160 512C142.3 512 128 497.7 128 480L128 224C128 206.3 142.3 192 160 192L256 192C273.7 192 288 177.7 288 160C288 142.3 273.7 128 256 128L160 128z"/></svg>Edit</a>
                        <button class="btn" onclick="handleRemove('<%= list[i].id %>')"><svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path fill="#FFFFFF" d="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z"/></svg>Delete</button>  
                    </div> 
                </div>
                
            </div>
            <% } %>
        </div>
    </div>
</div>
<script>
    async function handleRemove(listid) {
        //const item = itemId
        const list = listid
        //call api
        try {
            const response = await fetch('/api/list/delete', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            credentials: 'same-origin',
            body: JSON.stringify({listid: list}), // Convert the JavaScript object to a JSON string
            })
            if (response.status === 401) {
            alert('Unauthorized - redirecting to login');
            window.location.href = '/auth/login';
            return null;
            }
            //const data = await response.json();
            if (!response.ok) {
            throw new Error(response.error || `HTTP error! status: ${response.status}`);
            }
            console.log("Response:", await response)
            window.location.reload();
        } catch (error) {
            console.error('API call failed:', error);
            return null;
        }
        //reload
    }
</script>
<%- include('../../partials/footer') %>